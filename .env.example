# ============================================================
# TaoSim AI 增强层配置
#
# 复制此文件为 .env 并填入真实 API Key：
#   cp .env.example .env
#
# 当前支持 OpenAI 及兼容 API（OpenRouter / 本地模型等）。
# ============================================================

# OpenAI API Key（必填）
OPENAI_API_KEY=sk-your-key-here

# OpenAI 兼容 API Base URL（可选，默认 https://api.openai.com/v1）
# 支持 OpenRouter / 本地模型等兼容端点
# OPENAI_BASE_URL=https://api.openai.com/v1

# 默认模型（可选，默认 gpt-4o-mini）
# OPENAI_MODEL=gpt-4o-mini
